# Required. Set to a long random secret; enter the same value in extension settings.
API_KEY=change-me-to-a-long-random-secret

# Local development only. Railway PostgreSQL provides DATABASE_URL automatically.
# DATABASE_URL=postgresql://reflect:reflect@localhost:5432/reflect
# PORT=3000
# NODE_ENV=development

# Optional Cloudflare R2 image/note attachment storage.
# Leave unset to run without attachment uploads.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_DOMAIN=
