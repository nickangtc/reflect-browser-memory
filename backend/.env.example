# Railway PostgreSQL provides this automatically. For local dev, set your own.
DATABASE_URL=postgresql://reflect:reflect@localhost:5432/reflect

# Set to a long random secret; enter the same value in extension settings.
API_KEY=change-me-to-a-long-random-secret

NODE_ENV=development
PORT=3000

# Optional Cloudflare R2 image/note attachment storage.
# Leave blank to run without attachment uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_DOMAIN=
